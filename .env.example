DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eservicios_dev
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
FLASK_ENV=development

# Cloudflare R2 (fotos de tiendas de vendedor) — ver app/services/r2_service.py
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eservicios-vendor-photos
R2_PUBLIC_BASE_URL=

# Brevo (código de verificación de correo del vendedor) — ver app/services/email_service.py
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_PASSWORD=
BREVO_REMITENTE=no-responder@eservicios.org

# "Iniciar sesión con Google" del vendedor — ver app/services/google_auth_service.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Asistente de IA para descripciones de producto/bio de tienda — ver
# app/services/asistente_ia_service.py. PENDIENTE (2026-09-14): vacío a
# propósito hasta que se decida el proveedor y se cree la cuenta; los
# botones "Escribir con IA" del panel se ocultan solos mientras tanto.
AI_API_KEY=
AI_MODEL=claude-haiku-4-5

# Verificación de WhatsApp del vendedor vía Meta WhatsApp Business Platform
# (Cloud API) — ver claude/spec-tiendas-vendedor.md sección 11 y config.py.
# Mientras se prueba, WHATSAPP_PHONE_NUMBER_ID/WHATSAPP_BUSINESS_ACCOUNT_ID
# son los del número de prueba gratuito; WHATSAPP_CLOUD_API_TOKEN es el
# token temporal (vence ~24h). WHATSAPP_TEMPLATE_NAME queda vacío hasta
# tener la plantilla real de categoría "Authentication" aprobada.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_IDIOMA=es_MX
